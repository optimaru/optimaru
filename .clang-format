# One C++ style for the engine, the use cases and their tests: Google's rules
# with a four-space indent and 100 columns, which is how the engine was written.
# CI's lint job checks it; CONTRIBUTING.md has the command that applies it.
BasedOnStyle: Google
Standard: c++17
IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
ContinuationIndentWidth: 8
ConstructorInitializerIndentWidth: 4
DerivePointerAlignment: false
PointerAlignment: Left
# Includes keep the order they were written in.
SortIncludes: Never
IncludeBlocks: Preserve
