# sdist for the `optimaru` Python distribution: the Python package, the engine
# headers and, per use case, the bindings and C++ sources its extension compiles.
include LICENSE NOTICE THIRD-PARTY-LICENSES pyproject.toml setup.py docs/pypi.md
recursive-include optimaru *.py *.pyi py.typed
recursive-include optimaru/cpp *.hpp
recursive-include optimaru/*/cpp/include *.hpp
recursive-include optimaru/*/cpp/src *.cpp *.hpp
include optimaru/*/cpp/bindings.cpp
global-exclude *.so *.pyd __pycache__ *.pyc
prune tests
prune benchmarks
prune examples
